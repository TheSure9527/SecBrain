{
  "name": "secbrain",
  "version": "0.2.0",
  "description": "SecBrain — 本地优先的个人知识库 + AI 管家（macOS 桌面应用）",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:layers": "node scripts/check-layers.mjs",
    "verify": "npm run check:layers && npm run typecheck && npm test",
    "eval:dataset": "node scripts/eval-dataset.mjs",
    "eval:retrieval": "vite-node scripts/eval-retrieval.ts",
    "ics:export": "vite-node scripts/ics.ts export",
    "ics:serve": "vite-node scripts/ics.ts serve",
    "dist:mac": "bash scripts/build-dmg.sh"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@xenova/transformers": "^2.17.2",
    "chokidar": "^6.0.0",
    "chrono-node": "^2.10.3",
    "codemirror": "^6.0.2",
    "dingtalk-stream": "^2.1.6-beta.1",
    "dompurify": "^3.4.17",
    "gray-matter": "^4.0.3",
    "ical.js": "^2.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rrule": "^2.8.1",
    "tsdav": "^2.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "author": "SecBrain Contributors",
  "productName": "SecBrain"
}
